---
import '../styles/global.css';
// SEO (CD-261026). description: TODO Hemingway per-page copy (Gary approves) — fallback is the existing tagline.
// image: Jason OG default (CD-261026-J), 1200x630.
interface Props { title?: string; description?: string; image?: string; noindex?: boolean }
const { title = 'Cookie Dough Digital', description = 'A Boutique Digital Problem Solver for The Lowcountry', image = '/og/og-default.png', noindex = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const indexable = import.meta.env.INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(`${b}${image}`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Cookie Dough Digital',
  url: 'https://www.cookiedoughdigital.com',
  telephone: '+1-404-660-4023',
  email: 'cookiedoughdigital@gmail.com',
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '09:00', closes: '18:00' }],
  areaServed: [
    { '@type': 'City', name: 'Bluffton', containedInPlace: { '@type': 'State', name: 'South Carolina' } },
    { '@type': 'City', name: 'Hilton Head Island', containedInPlace: { '@type': 'State', name: 'South Carolina' } },
    { '@type': 'City', name: 'Beaufort', containedInPlace: { '@type': 'State', name: 'South Carolina' } },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
{!indexable && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href={`${b}/favicon-32.png`} />
<link rel="icon" type="image/png" sizes="64x64" href={`${b}/favicon-64.png`} />
<link rel="apple-touch-icon" href={`${b}/favicon-64.png`} />
<title>{title}</title><meta name="description" content={description} />
<meta property="og:type" content="website" /><meta property="og:site_name" content="Cookie Dough Digital" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content="1200" />}{imageUrl && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,700;7..72,800&family=Nunito+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
<header class="site-nav"><div class="container">
  <a class="logo" href={`${b}/`} aria-label="Cookie Dough Digital home">
    <img class="logo-lockup" src={`${b}/logo/lockup_white.png`} width="180" height="40" alt="Cookie Dough Digital" />
  </a>
  <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">☰</button>
  <nav id="nav-links" class="nav-links" aria-label="Main">
    <a href={`${b}/`}>Home</a><a href={`${b}/services/`}>Services</a><a href={`${b}/about/`}>About</a><a href={`${b}/contact/`}>Contact</a>
    <a class="btn btn-primary" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
  </nav>
</div></header>
<main><slot /></main>
<footer><div class="container"><div><slot name="footer">
  <p>Cookie Dough Digital · Bluffton, SC</p><p><a href="tel:4046604023">404-660-4023</a></p>
  <p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Mon–Sat 9AM–6PM</p>
</slot></div></div></footer>
<script>
const t=document.querySelector('.nav-toggle'),l=document.getElementById('nav-links');
t?.addEventListener('click',()=>{const o=l?.classList.toggle('open');t.setAttribute('aria-expanded',String(!!o));});
</script>
</body></html>
