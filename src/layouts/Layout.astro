---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Cookie Dough Digital', description = 'A Boutique Digital Problem Solver for The Lowcountry' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<link rel="icon" type="image/svg+xml" href={`${b}/favicon.svg`} />
<title>{title}</title><meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,700;7..72,800&family=Nunito+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
<header class="site-nav"><div class="container">
  <a class="wordmark" href={`${b}/`}>Cookie Dough Digital</a>
  <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">☰</button>
  <nav id="nav-links" class="nav-links" aria-label="Main">
    <a href={`${b}/services/`}>Services</a><a href={`${b}/work/`}>Work</a><a href={`${b}/about/`}>About</a><a href={`${b}/contact/`}>Contact</a>
    <a class="btn btn-primary" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
  </nav>
</div></header>
<main><slot /></main>
<footer><div class="container"><div><slot name="footer">
  <p>Cookie Dough Digital · Bluffton, SC</p><p><a href="tel:4046604023">404-660-4023</a></p>
  <p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Mon–Sat 9AM–6PM</p>
</slot></div></div></footer>
<script>
const t=document.querySelector('.nav-toggle'),l=document.getElementById('nav-links');
t?.addEventListener('click',()=>{const o=l?.classList.toggle('open');t.setAttribute('aria-expanded',String(!!o));});
</script>
</body></html>
