---
// CD-261124-1: inline Chip on /services/chatbots/ (placement 3). Click-to-load: no third-party JS or
// iframe until the visitor presses "Start chat" (the PayMeGPT iframe creates a contact on load).
import { CHIP_ENABLED, CHIP_WIDGET_ID } from '../chat.mjs';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{CHIP_ENABLED && (
<div class="chip-inline" id="chip-inline" data-widget={CHIP_WIDGET_ID}>
  <div class="chip-poster" id="chip-poster">
    <img src={`${b}/media/chip/chip-avatar-120.webp`} width="96" height="96" alt="" />
    <button type="button" class="btn btn-primary btn-aa" id="chip-start" aria-label="Start chat with Chip">Start chat</button>
    <p class="chip-inline-status" id="chip-inline-status" role="status" aria-live="polite"></p>
  </div>
</div>
)}
<script>
const wrap = document.getElementById('chip-inline');
const start = document.getElementById('chip-start') as HTMLButtonElement | null;
start?.addEventListener('click', () => {
  if (!wrap) return;
  const id = wrap.dataset.widget!;
  const f = document.createElement('iframe');
  f.src = `https://paymegpt.com/agents/${id}/embed`;
  f.title = "Chat with Chip, Cookie Dough Digital's AI assistant";
  f.setAttribute('allow', 'clipboard-write');
  f.className = 'chip-frame';
  const st = document.getElementById('chip-inline-status');
  const t = setTimeout(() => { if (st) st.textContent = 'Chat could not load. Call or text 843-603-3134, or email cookiedoughdigital@gmail.com.'; }, 15000);
  f.addEventListener('load', () => { clearTimeout(t); f.focus(); });
  wrap.replaceChildren(f);
});
</script>
<style>
.chip-inline{margin-top:28px;border:1px solid var(--border);border-radius:var(--r);background:var(--card);min-height:600px;display:flex;overflow:hidden}
.chip-poster{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px;padding:32px}
.chip-poster img{width:96px;height:96px;border-radius:50%;border:3px solid var(--copper);object-fit:cover}
.chip-inline-status{margin:0;font-size:14px;color:var(--marsh)}
:global(.chip-frame){display:block;width:100%;height:600px;border:0}
@media(max-width:820px){.chip-inline{min-height:480px}:global(.chip-frame){height:max(480px,70vh)}}
</style>
