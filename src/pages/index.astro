---
import Layout from '../layouts/Layout.astro';
const SHOW_RECENT_WORK = false; // CD-261025-19: hidden for now; flip to true to show Recent local work
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
import icoChat from '../../public/media/service-icons/chatbot-agents.svg?raw';
import icoWeb from '../../public/media/service-icons/websites.svg?raw';
import icoProj from '../../public/media/service-icons/digital-projects.svg?raw';
import icoAI from '../../public/media/service-icons/ai-training.svg?raw';
const svcIcons = {'Chatbot Agents':icoChat,'Websites':icoWeb,'Digital Projects':icoProj,'AI Training':icoAI}; // CD-261025-26
const services = [
  ['Chatbot Agents','Custom AI agents that book appointments, gather leads and follow up for you.'],
  ['Websites','Fast, clean sites built to get Lowcountry customers to call or book.'],
  ['Digital Projects','One-off fixes and builds. No monthly contract — pay for the project.'],
  ['AI Training','Hands-on sessions so your team actually uses the tools you pay for.'],
];
---
<Layout description="Boutique digital help for Bluffton, Hilton Head, and Beaufort small businesses. Chatbots, websites, and AI training with clear talk and a free consultation.">
<section class="hero on-marsh"><div class="container hero-grid">
  <div class="hero-copy">
    <p class="kicker">A Boutique Digital Problem Solver for The Lowcountry</p>
    <h1>Digital R.O.I. is sweet</h1>
    <p class="lede">Chatbots, websites and AI training for small businesses in Bluffton, Hilton Head and Beaufort. Plain talk, clear pricing, real results.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
      <a class="btn btn-ghost call-desktop" href="tel:4046604023">Call 404-660-4023</a>
      <a class="or-call" href="tel:4046604023">or call 404-660-4023</a>
    </div>
  </div>
  <div class="hero-ph hero-media">
    <video class="hero-video" autoplay muted playsinline preload="metadata" poster={`${b}/media/hero/hero-poster.jpg`} aria-hidden="true">
      <source src={`${b}/media/hero/hero-loop.webm`} type="video/webm" />
      <source src={`${b}/media/hero/hero-loop.mp4`} type="video/mp4" />
    </video>
    <img class="hero-poster" src={`${b}/media/hero/hero-poster.jpg`} width="1200" height="900" alt="Monitor with app icons settling into a neat grid" />
  </div>
</div></section>
<section class="section"><div class="container">
  <h2>What we do</h2>
  <div class="cards4">{services.map(([t,d]) => (
    <div class="card svc"><span class="svc-icon" aria-hidden="true" set:html={svcIcons[t]}></span><div class="rule"></div><h3>{t}</h3><p>{d}</p><a href={`${b}/services/`}>Learn more</a></div>))}</div>
</div></section>
{/* Recent local work: hidden per Gary (t70u, CD-261025-19). Set SHOW_RECENT_WORK = true to restore. */}
{SHOW_RECENT_WORK && (
<section class="section"><div class="container">
  <h2>Recent local work</h2>
  <div class="work">
    <figure><a class="work-link" href="https://www.buywoodpallets.com/" target="_blank" rel="noopener"><img class="shot work-img" src={`${b}/media/work/pallets-direct.jpg`} width="1024" height="756" alt="Pallets Direct website home page" loading="lazy" decoding="async" /><figcaption>Pallets Direct</figcaption></a></figure>
    {[2,3].map(() => (<figure><div class="ph shot"><span>Client site screenshot</span></div><figcaption>Client name (placeholder)</figcaption></figure>))}</div>
</div></section>
)}
<section class="section"><div class="container"><div class="band">
  <h2>Want to try a bite? Let's talk about your problem first.</h2>
  <a class="btn btn-dark" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
</div></div></section>
</Layout>
<script>
if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll<HTMLVideoElement>('.hero-video').forEach((v) => { v.pause(); v.removeAttribute('autoplay'); v.remove(); });
} else {
  // Play once and stop on the settled grid (hold is 5.0-6.3s; 6.3-7.0s unwinds back into the tornado)
  document.querySelectorAll<HTMLVideoElement>('.hero-video').forEach((v) => {
    let done = false;
    const stop = () => { if (done) return; done = true; v.pause(); v.currentTime = 5.8; };
    v.addEventListener('timeupdate', () => { if (v.currentTime >= 5.8) stop(); });
    v.addEventListener('ended', stop);
  });
}
</script>
<style>
.hero{background:var(--marsh);color:var(--oyster);padding:0}
/* Wider text col + slightly tighter gap so H1 stays 2 lines at 1440 */
.hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) 520px;gap:40px;align-items:center;min-height:720px;padding-top:40px;padding-bottom:56px}
.hero-copy{max-width:640px;min-width:0}
.hero-copy h1{max-width:18ch}
.lede{font-size:21px;margin:16px 0 28px;max-width:560px;line-height:1.45}
.ctas{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.or-call{display:none;color:var(--oyster);font-weight:500;font-size:16px;text-decoration:none}
.call-desktop{display:inline-block}
.hero-ph{width:520px;max-width:100%;height:auto;aspect-ratio:4/3;justify-self:end}
.hero-media{position:relative;overflow:hidden;border-radius:var(--r);background:var(--sage)}
.hero-video,.hero-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block}
.hero-poster{z-index:0}.hero-video{z-index:1}
@media (prefers-reduced-motion: reduce){.hero-video{display:none}}
/* Restore section top padding under marsh hero (was zeroed) */
.section{padding-top:var(--gap)}
.cards4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:32px}
.svc{padding:32px 22px 28px;display:flex;flex-direction:column;min-height:280px}
.svc-icon{display:block;width:52px;height:52px;color:var(--marsh);margin-bottom:14px;transition:color .2s}
.svc-icon svg{width:100%;height:100%;display:block}
.svc:hover .svc-icon{color:var(--copper)}
.svc .rule{width:40px;height:3px;background:var(--copper);margin-bottom:24px}
.svc p{color:var(--sage);margin:8px 0 16px;flex:1;font-size:16px}
.svc a{font-weight:700;text-decoration:none;color:var(--marsh)}
.work{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:32px}
.work figure{margin:0}.work-img{width:100%;height:auto;object-fit:cover;object-position:top;display:block;border-radius:var(--r);border:1px solid var(--border)}.work-link{color:inherit;text-decoration:none}.work-link:hover figcaption,.work-link:focus-visible figcaption{text-decoration:underline}.shot{aspect-ratio:16/10}figcaption{margin-top:8px;font-size:15px;color:var(--sage)}
.band{background:var(--copper);border-radius:var(--r);padding:48px 40px}
.band h2{color:var(--oyster);font-size:36px;margin-bottom:24px;max-width:1100px;white-space:nowrap}
@media(max-width:1280px){.band h2{white-space:normal}}
@media(max-width:1100px){
  .hero-grid{grid-template-columns:minmax(0,1fr) 400px;gap:32px}
  .hero-ph{width:400px}
  .hero-copy h1{max-width:none}
  .cards4{grid-template-columns:repeat(2,1fr)}
  .band h2{white-space:normal}
}
@media(max-width:820px){
  .hero-grid{grid-template-columns:1fr;min-height:640px;gap:28px;padding-top:32px}
  .hero-ph{width:100%;height:auto;aspect-ratio:4/3}
  /* Mobile: image between kicker and H1 */
  .hero-copy{display:contents}
  .hero-grid{gap:16px;align-content:center}
  .kicker{order:1;margin:0}.hero-ph{order:2}.hero-copy h1{order:3}.lede{order:4}.ctas{order:5}
  .lede{font-size:17px}
  .call-desktop{display:none}
  .or-call{display:inline}
  .cards4{grid-template-columns:1fr;gap:16px}
  .svc{min-height:0;padding:24px 20px}
  .work{grid-template-columns:1fr 1fr;gap:16px}
  .work figure:nth-child(3){display:none}
  .band{padding:32px 20px}.band h2{font-size:26px;white-space:normal}
}
</style>
