---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = [
  ['Chatbot Agents','Custom AI agents that book appointments, gather leads and follow up for you.'],
  ['Websites','Fast, clean sites built to get Lowcountry customers to call or book.'],
  ['Digital Projects','One-off fixes and builds. No monthly contract — pay for the project.'],
  ['AI Training','Hands-on sessions so your team actually uses the tools you pay for.'],
];
---
<Layout>
<section class="hero on-marsh"><div class="container hero-grid">
  <div>
    <p class="kicker">A Boutique Digital Problem Solver for The Lowcountry</p>
    <h1>Digital R.O.I. is sweet</h1>
    <p class="lede">Chatbots, websites and AI training for small businesses in Bluffton, Hilton Head and Beaufort. Plain talk, clear pricing, real results.</p>
    <div class="ctas"><a class="btn btn-primary" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
    <span class="or-call">or call</span><a class="btn btn-ghost" href="tel:4046604023">Call 404-660-4023</a></div>
  </div>
  <div class="ph hero-ph" role="img" aria-label="Photo placeholder"><span>Photo placeholder — Gary / local client work</span></div>
</div></section>
<section><div class="container">
  <h2>What we do</h2>
  <div class="cards4">{services.map(([t,d]) => (
    <div class="card svc"><div class="rule"></div><h3>{t}</h3><p>{d}</p><a href={`${b}/services/`}>Learn more</a></div>))}</div>
</div></section>
<section><div class="container">
  <h2>Recent local work</h2>
  <div class="work">{[1,2,3].map(() => (<figure><div class="ph shot"><span>Client site screenshot</span></div><figcaption>Client name (placeholder)</figcaption></figure>))}</div>
</div></section>
<section><div class="container"><div class="band">
  <h2>Want to try a bite? Let's talk about your problem first.</h2>
  <a class="btn btn-dark" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a Consultation</a>
</div></div></section>
</Layout>
<style>
.hero{background:var(--marsh);color:var(--oyster);padding:0}
.hero-grid{display:grid;grid-template-columns:1fr 560px;gap:56px;align-items:center;min-height:644px;padding-top:32px;padding-bottom:48px}
.lede{font-size:21px;margin:16px 0 28px;max-width:600px}
.ctas{display:flex;gap:14px;flex-wrap:wrap;align-items:center}.or-call{display:none}
.hero-ph{height:450px}
.cards4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:28px}
.svc{padding:22px;display:flex;flex-direction:column;min-height:240px}.svc .rule{width:40px;height:3px;background:var(--copper);margin-bottom:28px}
.svc p{color:var(--marsh);margin:8px 0 16px;flex:1}.svc a{font-weight:700;text-decoration:none}
.work{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:28px}.work figure{margin:0}.shot{aspect-ratio:16/10}figcaption{margin-top:8px;font-size:15px}
.band{background:var(--copper);border-radius:var(--r);padding:40px 32px 80px}.band h2{color:var(--oyster);font-size:36px;margin-bottom:20px}
@media(max-width:1100px){.hero-grid{grid-template-columns:1fr 420px}.cards4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){.hero-grid{grid-template-columns:1fr;min-height:560px;gap:24px}.hero-ph{height:130px}.lede{font-size:17px}
.or-call{display:inline;opacity:.85}.cards4{grid-template-columns:1fr;gap:16px}.svc{min-height:0}.work{grid-template-columns:1fr}.work figure:nth-child(3){display:none}
.band{padding:28px 20px 40px}.band h2{font-size:26px}}
</style>
