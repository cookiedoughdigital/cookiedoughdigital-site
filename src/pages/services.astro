---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  ['01','Chatbot Agents','Custom AI agents that book appointments, gather leads and follow up for you.','Book a Demo Call','primary',false,'/media/service-chatbots.png'],
  ['02','Websites','Fast, clean sites built to get Lowcountry customers to call or book.','Book a Consultation','ghost',false,'/media/service-websites.png'],
  ['03','Digital Projects','One-off fixes and builds. No monthly contract — pay for the project.','Get a Project Quote','primary',true,'/media/service-digital-projects.jpg'],
  ['04','AI Training','Hands-on sessions so your team actually uses the tools you pay for.','Book a Training Session','ghost',false,'/media/service-ai-training.png'],
] as const;
---
<Layout title="Services · Cookie Dough Digital">
<section class="head on-marsh"><div class="container head-grid">
  <div class="head-copy">
    <h1>Services</h1>
    <p class="lede">Solving the world's problems, one small business at a time. Pick what you need — nothing you don't.</p>
  </div>
  <img class="head-anim" src={`${b}/media/services-laptop.gif`} width="440" height="360" alt="Laptop opening to a website layout" />
</div></section>
<section class="section"><div class="container list">{items.map(([n,title,d,c,k,tag,img]) => (
  <article class="card item"><div class="txt">
    <p class="num">{n}</p><h2>{title}</h2>
    {tag && <span class="tag">No monthly contract</span>}
    <p class="body">{d} We start with a quick call to scope it, then a clear quote.</p>
    <div class="cta"><a class={`btn btn-${k}`} href={`mailto:cookiedoughdigital@gmail.com?subject=${encodeURIComponent(title)}`}>{c}</a></div>
  </div>{img
    ? <img class="sph thumb" src={`${b}${img}`} width="396" height="252" alt="" />
    : <div class="ph sph" role="img" aria-label="Photo placeholder"><span>Photo placeholder</span></div>
  }</article>))}
  <p class="also">Also: Google Ads · blog writing · graphic design · restaurant process</p>
</div></section>
<Fragment slot="footer"><p><a href="tel:4046604023">404-660-4023</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:0}
.head-grid{min-height:480px;display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,440px);gap:32px;align-items:center;padding-top:24px;padding-bottom:48px}
.head-copy{min-width:0}
h1{font-size:76px}
.lede{font-size:18px;max-width:720px;margin:12px 0 0;line-height:1.4}
.head-anim{width:100%;max-width:420px;height:360px;object-fit:cover;object-position:center;justify-self:end;display:block;border-radius:var(--r);background:#fff}
.section{padding-top:var(--gap)}
.list{display:flex;flex-direction:column;gap:24px}
.item{display:grid;grid-template-columns:minmax(0,1.65fr) 396px;gap:32px;align-items:stretch;padding:28px 28px 28px 32px;min-height:280px}
.txt{display:flex;flex-direction:column;gap:10px;padding-top:8px;min-width:0}
.num{color:var(--copper);font-weight:700;margin:0;font-size:15px}
.item h2{font-size:32px}
.body{font-size:18px;margin:0;color:var(--sage);max-width:none;line-height:1.45}
.tag{align-self:flex-start;margin:2px 0}
.cta{margin-top:auto;padding-top:12px}
.sph{width:396px;max-width:100%;height:252px;justify-self:end}
.thumb{object-fit:cover;border-radius:var(--r);display:block;background:var(--card)}
.also{margin-top:28px;font-size:16px;color:var(--sage)}
@media(max-width:1100px){.item{grid-template-columns:minmax(0,1.2fr) 300px}.sph{width:300px;height:200px}}
@media(max-width:820px){
  .head-grid{grid-template-columns:1fr;min-height:0;gap:20px;padding-top:32px;padding-bottom:32px}
  .head-anim{max-width:280px;justify-self:start}
  h1{font-size:44px}.lede{font-size:15px}
  .item{grid-template-columns:1fr;min-height:0;padding:24px 20px}
  .sph{display:none}
  .item h2{font-size:24px}.body{font-size:15px}
  .list{gap:16px}
}
</style>
