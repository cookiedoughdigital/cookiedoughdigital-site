---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Contact · Cookie Dough Digital">
<section class="head on-marsh"><div class="container head-grid">
  <div class="head-copy">
    <p class="eyebrow">Contact</p>
    <h1>Let's get together and brainstorm</h1>
  </div>
  <div class="media">
    <video class="brain" autoplay muted loop playsinline preload="metadata" poster={`${b}/media/contact/brain-poster.jpg`} aria-hidden="true">
      <source src={`${b}/media/contact/brain.webm`} type="video/webm" />
      <source src={`${b}/media/contact/brain.mp4`} type="video/mp4" />
    </video>
    <img class="brain-poster" src={`${b}/media/contact/brain-poster.jpg`} width="400" height="225" alt="Glowing blue brain" />
  </div>
</div></section>
<section class="section"><div class="container contact-grid">
  <form class="card form" id="contact-form" action="mailto:cookiedoughdigital@gmail.com" method="post" enctype="text/plain">
    <h2>Send a message</h2>
    <label>Name<input name="name" type="text" autocomplete="name" required /></label>
    <label>Email<input name="email" type="email" autocomplete="email" required /></label>
    <label>Phone <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
    <label>Message<textarea name="message" rows="6" required></textarea></label>
    <button class="btn btn-primary" type="submit">Send message</button>
    <p class="note" id="form-note" role="status" aria-live="polite">This opens your email app with your message filled in.</p>
  </form>
  <aside class="details">
    <h2>Reach us directly</h2>
    <p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p>
    <p><a href="tel:4046604023">404-660-4023</a></p>
    <p>Monday–Saturday 9AM–6PM<br />Closed Sundays</p>
    <p>Bluffton, South Carolina</p>
  </aside>
</div></section>
<Fragment slot="footer"><p><a href="tel:4046604023">404-660-4023</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<script>
if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll<HTMLVideoElement>('.brain').forEach((v) => { v.pause(); v.remove(); });
}
const f = document.getElementById('contact-form') as HTMLFormElement | null;
f?.addEventListener('submit', (e) => {
  e.preventDefault();
  if (!f.reportValidity()) return;
  const d = new FormData(f);
  const name = String(d.get('name') || '');
  const body = `Name: ${name}\nEmail: ${d.get('email')}\nPhone: ${d.get('phone') || ''}\n\n${d.get('message')}`;
  location.href = `mailto:cookiedoughdigital@gmail.com?subject=${encodeURIComponent('Website inquiry from ' + name)}&body=${encodeURIComponent(body)}`;
  const n = document.getElementById('form-note'); if (n) n.textContent = 'Your email app should open with the message ready to send.';
});
</script>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:0}
.head-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,520px);gap:40px;align-items:center;padding-top:48px;padding-bottom:56px}
.eyebrow{margin:0 0 8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:14px;opacity:.85}
h1{font-size:64px;max-width:14ch}
.media{position:relative;aspect-ratio:16/9;border-radius:var(--r);overflow:hidden;background:#000}
.brain,.brain-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.brain{z-index:1}
@media (prefers-reduced-motion: reduce){.brain{display:none}}
.section{padding-top:var(--gap);padding-bottom:var(--gap)}
.contact-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:48px;align-items:start}
.form{padding:32px;display:flex;flex-direction:column;gap:16px}
.form h2,.details h2{font-size:28px;margin:0 0 4px}
label{display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:15px}
.opt{font-weight:400;color:var(--sage)}
input,textarea{font:inherit;font-weight:400;font-size:16px;padding:12px;border:1px solid var(--border);border-radius:var(--r);background:#fff;color:inherit}
input:focus-visible,textarea:focus-visible{outline:3px solid var(--copper);outline-offset:1px}
.form .btn{align-self:flex-start;cursor:pointer}
.note{font-size:14px;color:var(--sage);margin:0}
.details p{font-size:18px;margin:0 0 12px}
@media(max-width:820px){
  .head-grid{grid-template-columns:1fr;gap:20px;padding-top:32px;padding-bottom:32px}
  h1{font-size:40px}
  .contact-grid{grid-template-columns:1fr;gap:32px}
  .form{padding:24px 20px}
}
</style>
