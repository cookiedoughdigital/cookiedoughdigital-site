---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Contact · Cookie Dough Digital" description="Book a free consultation with Cookie Dough Digital in Bluffton. Email or call for chatbot, website, ads, or AI help across Hilton Head and Beaufort.">
<section class="head on-marsh"><div class="container head-inner">
  <p class="eyebrow">Contact</p>
  <h1>Let's get together and brainstorm</h1>
</div></section>
<section class="section"><div class="container contact-grid">
  <div class="card form" id="contact-form">
    <h2>Send a message</h2>
    <p class="privacy">By sending this form, you agree we can contact you about your request. We don't sell your info, and we only share it with the tools that help us handle your request. See our <a href={`${b}/privacy/`}>Privacy Policy</a>.</p>
    <div id="pmg-form" class="pmg-form" aria-busy="true"><p class="note">Loading the form…</p></div>
    <p class="note" id="form-note" role="status" aria-live="polite">Rather call? Call or text <a href="tel:+18436033134">843-603-3134</a>, or email <a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a>.</p>
    <noscript><p class="note">The form needs JavaScript. Call or text <a href="tel:+18436033134">843-603-3134</a>, or email <a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a>.</p></noscript>
  </div>
  <div class="info">
    <div class="media">
      <video class="brain" autoplay muted loop playsinline preload="metadata" poster={`${b}/media/contact/brain-poster.jpg`} aria-hidden="true">
      <source src={`${b}/media/contact/brain.webm`} type="video/webm" />
      <source src={`${b}/media/contact/brain.mp4`} type="video/mp4" />
      </video>
      <img class="brain-poster" src={`${b}/media/contact/brain-poster.jpg`} width="400" height="225" alt="Glowing blue brain" />
    </div>
    <aside class="details">
    <h2>Reach us directly</h2>
    <p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p>
    <p><a href="tel:+18436033134">843-603-3134</a></p>
    <p>Monday–Saturday 9AM–6PM<br />Closed Sundays</p>
    <p>Bluffton, South Carolina</p>
  </aside>
  </div>
</div></section>
<Fragment slot="footer"><p><a href="tel:+18436033134">843-603-3134</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<script>
if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll<HTMLVideoElement>('.brain').forEach((v) => { v.pause(); v.remove(); });
}
// CD-261119-4: contact form = PayMeGPT native form 8gtq1hx3 (CDD Contact form, linked to agent Chip).
// Submissions land in PayMeGPT (contact + form submission). Success message is set in the PayMeGPT form.
const box = document.getElementById('pmg-form');
if (box) {
  const s = document.createElement('script');
  s.src = 'https://paymegpt.com/forms-embed.js'; s.async = true;
  Object.assign(s.dataset, { form: '8gtq1hx3', theme: 'light', accent: '#CD7641', bg: '#FBF9F5', surface: '#FBF9F5', field: '#FFFFFF', text: '#1F3D2F', gradient: '0', source: 'site-contact' });
  const fail = () => {
    box.removeAttribute('aria-busy');
    box.innerHTML = '<p class="err" role="alert">Sorry, the form didn\'t load. Please call or text <a href="tel:+18436033134">843-603-3134</a>, or email <a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a>.</p>';
  };
  s.onerror = fail;
  box.appendChild(s);
  const t0 = Date.now();
  const poll = setInterval(() => {
    if (box.querySelector('iframe')) { clearInterval(poll); box.removeAttribute('aria-busy'); box.querySelector('.note')?.remove(); }
    else if (Date.now() - t0 > 12000) { clearInterval(poll); fail(); }
  }, 200);
}
</script>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:0}
.head-inner{padding-top:48px;padding-bottom:56px;text-align:center}
.eyebrow{margin:0 0 8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:14px;opacity:.85}
h1{font-size:64px;max-width:none}
.media{position:relative;aspect-ratio:16/9;border-radius:var(--r);overflow:hidden;background:var(--marsh)}
.brain,.brain-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.brain{z-index:1}
@media (prefers-reduced-motion: reduce){.brain{display:none}}
.section{padding-top:var(--gap);padding-bottom:var(--gap)}
.contact-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:48px;align-items:start}
.form{padding:32px;display:flex;flex-direction:column;gap:16px}
.form h2,.details h2{font-size:28px;margin:0 0 4px}
label{display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:15px}
.opt{font-weight:400;color:var(--sage)}
input,textarea{font:inherit;font-weight:400;font-size:16px;padding:12px;border:1px solid var(--border);border-radius:var(--r);background:#fff;color:inherit}
input:focus-visible,textarea:focus-visible{outline:3px solid var(--copper);outline-offset:1px}
.form .btn{align-self:flex-start;cursor:pointer}
.note{font-size:14px;color:var(--sage);margin:0}
.privacy{font-size:14px;margin:0;color:var(--marsh)}
.pmg-form{min-height:420px}
.err{color:#8A2B12;font-weight:700;margin:0}
.info{display:flex;flex-direction:column;gap:28px}
.details p{font-size:18px;margin:0 0 12px}
@media(max-width:820px){
  .head-inner{padding-top:32px;padding-bottom:32px}
  h1{font-size:40px}
  .contact-grid{grid-template-columns:1fr;gap:32px}
  .contact-grid .info{display:contents}
  .contact-grid .media{order:-1}
  .contact-grid .details{order:1}
  .form{padding:24px 20px}
}
</style>
