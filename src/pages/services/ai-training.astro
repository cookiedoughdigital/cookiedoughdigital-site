---
import Layout from '../../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
// CD-261117-2 DRAFT (staging only; noindex via src/draft.mjs). Gary approved structure 2026-11-17 10:54 PM ET; go-live needs Hemingway check + Webster QA + Gary yes.
// Copy: Hemingway rewrite 08_service_ai-training.md (CD-261031-1). Layout: Jason mock 2026-10-28/services/ai-training.html.
// Certs: same list, files, markup and script as about.astro (copied, not shared, so About is untouched).
// Price: CDD_rate_card_LOCKED_2026-11-07 #9 Business AI Implementation Consultation = $1,000–$3,000. Gary confirmed Nov 17 11:11 PM: AI Training = item 9; this line is final.
const steps = [
  ['01','Prompting that works','How to ask AI for useful answers, using your own examples.'],
  ['02','Strengths and weaknesses','Where AI shines, where it fumbles and how to check its work.'],
  ['03','Team exercises','Hands-on practice so the skills stick after we leave.'],
  ['04','Find the opportunities','We map the spots in your workflow where AI can save real time.'],
];
const certs = [
  ['google-ai-professional-certificate','Google AI Professional Certificate (Coursera), Gary Daniel Graham, Jul 12, 2026'],
  ['google-ai-fundamentals','Google AI Fundamentals course certificate (Coursera), Gary Daniel Graham, Jun 14, 2026'],
  ['google-ai-brainstorming-planning','Google AI for Brainstorming and Planning course certificate (Coursera), Jun 17, 2026'],
  ['google-ai-research-insights','Google AI for Research and Insights course certificate (Coursera), Jun 19, 2026'],
  ['google-ai-writing-communicating','Google AI for Writing and Communicating course certificate (Coursera), Jun 23, 2026'],
  ['google-ai-content-creation','Google AI for Content Creation course certificate (Coursera), Jun 26, 2026'],
  ['google-ai-data-analysis','Google AI for Data Analysis course certificate (Coursera), Jul 1, 2026'],
  ['google-ai-app-building','Google AI for App Building course certificate (Coursera), Jul 12, 2026'],
  ['linkedin-microsoft-generative-ai','Career Essentials in Generative AI by Microsoft and LinkedIn, Gary Daniel Graham, Jul 11, 2023'],
  ['coursiv-ai-mastery','Coursiv AI Mastery Certificate Program, Gary Graham, 7 June 2026'],
  ['coursiv-chatgpt','Coursiv Master of ChatGPT certificate, Gary Graham'],
  ['coursiv-claude','Coursiv Master of Claude certificate, Gary Graham'],
  ['coursiv-gemini','Coursiv Master of Gemini certificate, Gary Graham'],
  ['coursiv-midjourney','Coursiv Master of Midjourney certificate, Gary Graham'],
  ['coursiv-canva-ai','Coursiv Master of Canva AI certificate, Gary Graham'],
  ['coursiv-lovable','Coursiv Master of Lovable certificate, Gary Graham'],
];
const mail = 'mailto:cookiedoughdigital@gmail.com?subject=AI%20Training%20Session';
---
<Layout title="AI Training · Cookie Dough Digital" description="Hands-on AI training for Lowcountry small business teams. Practical sessions built around your real work. Free call first, then a clear quote.">
<section class="head on-marsh"><div class="container">
  <p class="crumb"><a href={`${b}/services/`}>← All services</a> &nbsp;/&nbsp; AI Training</p>
  <p class="kicker">Services · 04</p><h1>AI Training</h1>
  <p class="lede">Hands-on sessions so your team actually uses the tools you pay for.</p>
</div></section>
<section class="section"><div class="container hero">
  <div><p class="body">Custom presentations and practical exercises built around your team's real work. AI is a tool in your team's hands, not a replacement for them.</p>
  <a class="btn btn-primary" href={mail}>Book a Training Session</a>
  <p class="price-line"><span class="price-label">Price</span> $1,000–$3,000, quoted after a free call · <a href={`${b}/pricing/`}>See pricing</a></p></div>
  <img src={`${b}/media/service-ai-training.png`} width="1280" height="1012" alt="" />
</div></section>
<section class="section" style="padding-top:0"><div class="container">
  <p class="kicker">What you get</p><h2>What we cover</h2>
  <div class="grid4">{steps.map(([n,t,d]) => <article class="card step"><p class="num">{n}</p><h3>{t}</h3><p>{d}</p></article>)}</div>
</div></section>
<section class="section certs" aria-labelledby="certs-h"><div class="container">
  <h2 id="certs-h">Credentials that keep the kitchen honest</h2>
  <p class="intro">A few of the badges and trainings behind the work, so you know the advice isn't kitchen-sink improvisation.</p>
  <div class="carousel collapsed" role="region" aria-roledescription="carousel" aria-label="Certifications" tabindex="0">
    <div class="track" aria-live="polite">{certs.map(([f,alt],i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i+1} of ${certs.length}`} hidden={i!==0}>
        <img class="cert" src={i===0?`${b}/media/certs/${f}.jpg`:undefined} data-src={i===0?undefined:`${b}/media/certs/${f}.jpg`} alt={alt} loading={i===0?'eager':'lazy'} decoding="async" />
      </div>))}
    </div>
    <p class="count" aria-hidden="true"><span class="cur">1</span> / {certs.length}</p>
    <div class="controls">
      <button type="button" class="nav prev" aria-label="Previous certification">‹</button>
      <div class="dots">{certs.map((_,i) => <button type="button" class="dot" aria-label={`Show certification ${i+1}`} aria-current={i===0?'true':'false'}></button>)}</div>
      <button type="button" class="nav next" aria-label="Next certification">›</button>
    </div>
    <button type="button" class="btn btn-primary see-more">See more</button>
  </div>
</div></section>
<section class="section"><div class="container"><div class="band on-marsh">
  <div><h2>Ready when you are.</h2><p>We start with a free call to scope it, then a clear quote.</p></div>
  <a class="btn btn-primary" href={mail}>Book a Training Session</a>
</div></div></section>
<Fragment slot="footer"><p><a href="tel:4046604023">404-660-4023</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<script>
document.querySelectorAll<HTMLElement>('.carousel').forEach((c) => {
  const slides = [...c.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...c.querySelectorAll<HTMLButtonElement>('.dot')];
  const track = c.querySelector<HTMLElement>('.track')!;
  let i = 0, timer: number | undefined;
  const show = (n: number) => { i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => s.hidden = k !== i);
    dots.forEach((d, k) => d.setAttribute('aria-current', String(k === i)));
    const cur = c.querySelector('.cur'); if (cur) cur.textContent = String(i + 1); };
  c.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
  c.querySelector('.next')!.addEventListener('click', () => show(i + 1));
  dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
  c.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  let x0: number | null = null;
  c.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  c.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); x0 = null; });
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stop = () => { clearInterval(timer); timer = undefined; track.setAttribute('aria-live', 'polite'); };
  const start = () => { if (reduce || timer) return; track.setAttribute('aria-live', 'off'); timer = window.setInterval(() => show(i + 1), 5000); };
  ['mouseenter', 'focusin'].forEach((ev) => c.addEventListener(ev, stop));
  ['mouseleave', 'focusout'].forEach((ev) => c.addEventListener(ev, () => { if (c.classList.contains('collapsed')) return; if (!c.matches(':hover') && !c.contains(document.activeElement)) start(); }));
  const more = c.querySelector<HTMLButtonElement>('.see-more');
  if (more) {
    more.addEventListener('click', () => {
      c.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((im) => { im.src = im.dataset.src!; im.removeAttribute('data-src'); });
      c.classList.remove('collapsed');
      more.remove();
      c.querySelector<HTMLButtonElement>('.next')?.focus();
    });
  } else start();
});
</script>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:24px 0 72px}
.crumb{font-size:14px;opacity:.8;margin:0 0 40px}.crumb a{text-decoration:none;color:inherit}
.kicker{margin:0 0 8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:14px;color:var(--copper)}
.head .kicker{color:var(--oyster);opacity:.85}
.head h1{font-size:76px;margin-top:4px}.lede{font-size:20px;max-width:720px;margin:16px 0 0;line-height:1.45}
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center}
.hero p.body{font-size:20px;line-height:1.6;color:var(--marsh);margin:0 0 24px}
.hero img{width:100%;height:auto;aspect-ratio:1280/1012;object-fit:cover;border-radius:var(--r);border:1px solid var(--border);background:var(--card)}
.price-line{margin:20px 0 0;font-size:16px;color:var(--marsh)}.price-line a{color:var(--copper);font-weight:700}
.price-label{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--sage);border:1px solid var(--border);border-radius:var(--r);padding:2px 8px;margin-right:6px}
.num{color:var(--copper);font-weight:700;margin:0 0 8px;font-size:15px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:32px}
.step{padding:28px}.step p:not(.num){color:var(--sage);font-size:16px;margin:10px 0 0}
.certs h2{font-size:40px;margin-bottom:24px}
.intro{font-size:18px;line-height:1.6;max-width:720px;margin:0 0 24px;color:var(--sage)}
.carousel{max-width:480px;margin:0 auto}
.cert{aspect-ratio:4/3;width:100%;object-fit:contain;background:#fff;border:1px solid var(--border);border-radius:var(--r);display:block}
.carousel.collapsed .count,.carousel.collapsed .controls{display:none}
.see-more{display:block;margin:16px auto 0;cursor:pointer}
.count{text-align:center;color:var(--sage);font-size:14px;margin:8px 0 0}
.controls{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:16px}
.nav{width:44px;height:44px;border-radius:50%;border:1px solid var(--marsh);background:transparent;color:var(--marsh);font-size:26px;line-height:1;cursor:pointer}
.dots{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:70%}
.dot{width:12px;height:12px;border-radius:50%;border:1px solid var(--marsh);background:transparent;padding:0;cursor:pointer}
.dot[aria-current="true"]{background:var(--marsh)}
.band{background:var(--marsh);color:var(--oyster);border-radius:var(--r);padding:56px;display:flex;justify-content:space-between;align-items:center;gap:32px}
.band h2{font-size:40px}.band p{margin:10px 0 0;font-size:18px;opacity:.9}.band .btn{font-size:20px;padding:18px 30px;white-space:nowrap}
@media(max-width:1000px){.grid4{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.head{padding:16px 0 40px}.crumb{margin-bottom:24px}.head h1{font-size:44px}.lede{font-size:16px}
.hero{grid-template-columns:1fr;gap:28px}.hero p.body{font-size:17px}.grid4{grid-template-columns:1fr;gap:16px}.step{padding:20px}
.dots{display:none}.intro{font-size:16px}.certs h2{font-size:30px}
.band{flex-direction:column;align-items:flex-start;padding:32px 24px}.band h2{font-size:28px}.band .btn{font-size:17px}}
</style>
