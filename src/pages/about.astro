---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const story = [
  "I’m Gary Graham, founder of Cookie Dough Digital. My whole career has been about solving problems, connecting dots, and building things that actually work, in a kitchen, behind a desk, or deep in a digital project. The question never changes: how can this be better?",
  "I grew up in New York’s Hudson Valley, about a hundred miles north of the city, raised by a single mother who taught me curiosity, hard work, and the courage to ask hard questions. Waiting-room TIME magazines and tough classroom debates left me with a lasting respect for how things work, and a habit of trying to improve them.",
  "That mindset followed me when I traded books for chef’s knives. I worked my way from prep cook to the opening team of a semi-fine dining restaurant, and fell hard for the art and science of barbecue. Kitchens are fast, chaotic, and unforgiving: the best training I’ve ever had for managing people, pressure, and process.",
  "In 2014 I left the kitchen and started from the ground floor in Bluffton, South Carolina: data entry at Jester Communications, no formal tech degree. The same kitchen rules applied: learn fast, stay curious, take ownership. That path led through QA Testing, client management, Agile workflows, small-business social, and chatbot conversational marketing.",
  "Cookie Dough Digital grew out of that work. Small businesses don’t need more buzzwords. They need clear solutions, a partner who shows up, and someone who cares about their success as much as they do.",
  "I’m still hooked on solving problems, my favorite bad habit, and proud to call Bluffton home with my wife and daughter. Whether you need a website that works, help with ads or AI, a chatbot that actually books leads, or someone to untangle a messy digital project, we’re here to get it done the right way.",
];
const art = [
  ['mandala','Pen-and-ink mandala ringed with small planets'],
  ['zentangle-columns','Zentangle drawing of stacked columns over black and white stripes, signed GDG 7/4/2018'],
  ['pattern-grid','Ink pattern sampler: a grid of 40 different hand-drawn patterns beside a pen'],
  ['geometric-bands','Ink drawing in vertical bands of bricks, 3D cubes, dotted tiles and interlocking shapes'],
  ['swan-wing','Ink and marker drawing of a feathered wing with a red accent'],
  ['animal-skull','Stippled ink sketch of an animal skull in a spiral sketchbook'],
  ['mushrooms','Crosshatched ink drawing of two spotted mushrooms with green grass'],
  ['tree','Brush-pen outline of a broad tree in a sketchbook'],
  ['dragonfly','Detailed ink dragonfly with blue and gold body beside a brush pen'],
  ['fiddler-crab','Stippled ink drawing of a crab'],
  ['bird','Ink sketch of a small bird perched on a berry branch'],
  ['jack-o-lanterns','Ink drawing of three jack-o’-lanterns wrapped in swirls and candy'],
  ['square-zentangle','Square zentangle with a triangle border, dated 10/28/23'],
  ['neurographic','Neurographic drawing with blue, turquoise and magenta cells'],
];
const certs = [
  ['google-ai-professional-certificate','Google AI Professional Certificate (Coursera), Gary Daniel Graham, Jul 12, 2026'],
  ['google-ai-fundamentals','Google AI Fundamentals course certificate (Coursera), Gary Daniel Graham, Jun 14, 2026'],
  ['google-ai-brainstorming-planning','Google AI for Brainstorming and Planning course certificate (Coursera), Jun 17, 2026'],
  ['google-ai-research-insights','Google AI for Research and Insights course certificate (Coursera), Jun 19, 2026'],
  ['google-ai-writing-communicating','Google AI for Writing and Communicating course certificate (Coursera), Jun 23, 2026'],
  ['google-ai-content-creation','Google AI for Content Creation course certificate (Coursera), Jun 26, 2026'],
  ['google-ai-data-analysis','Google AI for Data Analysis course certificate (Coursera), Jul 1, 2026'],
  ['google-ai-app-building','Google AI for App Building course certificate (Coursera), Jul 12, 2026'],
  ['linkedin-microsoft-generative-ai','Career Essentials in Generative AI by Microsoft and LinkedIn, Gary Daniel Graham, Jul 11, 2023'],
  ['coursiv-ai-mastery','Coursiv AI Mastery Certificate Program, Gary Graham, 7 June 2026'],
  ['coursiv-chatgpt','Coursiv Master of ChatGPT certificate, Gary Graham'],
  ['coursiv-claude','Coursiv Master of Claude certificate, Gary Graham'],
  ['coursiv-gemini','Coursiv Master of Gemini certificate, Gary Graham'],
  ['coursiv-midjourney','Coursiv Master of Midjourney certificate, Gary Graham'],
  ['coursiv-canva-ai','Coursiv Master of Canva AI certificate, Gary Graham'],
  ['coursiv-lovable','Coursiv Master of Lovable certificate, Gary Graham'],
];
---
<Layout title="About · Cookie Dough Digital">
<section class="head on-marsh"><div class="container">
  <p class="eyebrow">About</p>
  <h1>The Main Ingredient</h1>
</div></section>
<section class="section"><div class="container story">
  <img class="portrait" src={`${b}/media/gary-headshot.jpg`} width="1024" height="912" alt="Gary Graham, founder of Cookie Dough Digital" />
  <div class="copy">{story.map((p) => <p>{p}</p>)}</div>
</div></section>
<section class="section cta-sec"><div class="container"><div class="band">
  <a class="btn btn-dark" href="mailto:cookiedoughdigital@gmail.com?subject=Free%20consultation">Book a free consultation →</a>
  <p class="contact"><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a> · <a href="tel:4046604023">404-660-4023</a></p>
  <p class="contact">Monday–Saturday 9AM–6PM · Closed Sundays · Bluffton, South Carolina</p>
</div></div></section>
<section class="section certs" aria-labelledby="certs-h"><div class="container">
  <h2 id="certs-h">Certifications</h2>
  <div class="carousel" role="region" aria-roledescription="carousel" aria-label="Certifications" tabindex="0">
    <div class="track" aria-live="polite">{certs.map(([f,alt],i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i+1} of ${certs.length}`} hidden={i!==0}>
        <img class="cert" src={`${b}/media/certs/${f}.jpg`} alt={alt} loading={i===0?'eager':'lazy'} decoding="async" />
      </div>))}
    </div>
    <p class="count" aria-hidden="true"><span class="cur">1</span> / {certs.length}</p>
    <div class="controls">
      <button type="button" class="nav prev" aria-label="Previous certification">‹</button>
      <div class="dots">{certs.map((_,i) => <button type="button" class="dot" aria-label={`Show certification ${i+1}`} aria-current={i===0?'true':'false'}></button>)}</div>
      <button type="button" class="nav next" aria-label="Next certification">›</button>
    </div>
  </div>
</div></section>
<section class="section certs kitchen" aria-labelledby="kitchen-h"><div class="container">
  <h2 id="kitchen-h">A few more plates from the kitchen</h2>
  <p class="intro">When I’m not fixing digital messes, I’m usually making something with my hands: sketches, paintings, and the odd piece that started as a doodle and refused to stay quiet. Here’s a little of that side of the work.</p>
  <div class="carousel" role="region" aria-roledescription="carousel" aria-label="Art gallery" tabindex="0">
    <div class="track" aria-live="polite">{art.map(([f,alt],i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i+1} of ${art.length}`} hidden={i!==0}>
        <img class="cert art" src={`${b}/media/kitchen/${f}.jpg`} alt={alt} loading={i===0?'eager':'lazy'} decoding="async" />
      </div>))}
    </div>
    <p class="count" aria-hidden="true"><span class="cur">1</span> / {art.length}</p>
    <div class="controls">
      <button type="button" class="nav prev" aria-label="Previous artwork">‹</button>
      <div class="dots">{art.map((_,i) => <button type="button" class="dot" aria-label={`Show artwork ${i+1}`} aria-current={i===0?'true':'false'}></button>)}</div>
      <button type="button" class="nav next" aria-label="Next artwork">›</button>
    </div>
  </div>
</div></section>
<Fragment slot="footer"><p><a href="tel:4046604023">404-660-4023</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<script>
document.querySelectorAll<HTMLElement>('.carousel').forEach((c) => {
  const slides = [...c.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...c.querySelectorAll<HTMLButtonElement>('.dot')];
  const track = c.querySelector<HTMLElement>('.track')!;
  let i = 0, timer: number | undefined;
  const show = (n: number) => { i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => s.hidden = k !== i);
    dots.forEach((d, k) => d.setAttribute('aria-current', String(k === i)));
    const cur = c.querySelector('.cur'); if (cur) cur.textContent = String(i + 1); };
  c.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
  c.querySelector('.next')!.addEventListener('click', () => show(i + 1));
  dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
  c.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  let x0: number | null = null;
  c.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  c.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); x0 = null; });
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stop = () => { clearInterval(timer); timer = undefined; track.setAttribute('aria-live', 'polite'); };
  const start = () => { if (reduce || timer) return; track.setAttribute('aria-live', 'off'); timer = window.setInterval(() => show(i + 1), 5000); };
  ['mouseenter', 'focusin'].forEach((ev) => c.addEventListener(ev, stop));
  ['mouseleave', 'focusout'].forEach((ev) => c.addEventListener(ev, () => { if (!c.matches(':hover') && !c.contains(document.activeElement)) start(); }));
  start();
});
</script>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:64px 0 56px}
.eyebrow{margin:0 0 8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:14px;color:var(--oyster);opacity:.85}
h1{font-size:76px}
.section{padding-top:var(--gap)}
.story{display:flow-root}
.copy p{font-size:18px;line-height:1.6;margin:0 0 20px}
.copy p:last-child{margin-bottom:0}
.cta-sec{padding-top:48px}
.portrait{aspect-ratio:3/4;width:340px;height:auto;max-width:40%;float:right;margin:6px 0 16px 48px;object-fit:cover;object-position:35% 20%;border-radius:var(--r);display:block}

.band{background:var(--copper);border-radius:var(--r);padding:48px 40px}
.contact{color:var(--oyster);margin:16px 0 0;font-size:16px}.contact+.contact{margin-top:4px}
.contact a{color:var(--oyster)}
.certs{padding-bottom:var(--gap)}
.certs h2{font-size:40px;margin-bottom:24px}
.kitchen{padding-top:0}
.art{background:var(--oyster)}
.kitchen h2{margin-bottom:12px}
.intro{font-size:18px;line-height:1.6;max-width:720px;margin:0 0 24px;color:var(--sage)}
.carousel{max-width:960px;margin:0 auto}
.cert{aspect-ratio:4/3;width:100%;object-fit:contain;background:#fff;border:1px solid var(--border);border-radius:var(--r);display:block}
.count{text-align:center;color:var(--sage);font-size:14px;margin:8px 0 0}
.controls{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:16px}
.nav{width:44px;height:44px;border-radius:50%;border:1px solid var(--marsh);background:transparent;color:var(--marsh);font-size:26px;line-height:1;cursor:pointer}
.dots{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:70%}
.dot{width:12px;height:12px;border-radius:50%;border:1px solid var(--marsh);background:transparent;padding:0;cursor:pointer}
.dot[aria-current="true"]{background:var(--marsh)}
@media(max-width:820px){
  h1{font-size:44px}.head{padding:40px 0 32px}
  .portrait{float:none;width:100%;max-width:360px;margin:0 auto 24px}
  .copy p{font-size:16px}
  .band{padding:32px 20px}
  .certs h2{font-size:30px}
  .dots{display:none}
    .intro{font-size:16px}
}
</style>
