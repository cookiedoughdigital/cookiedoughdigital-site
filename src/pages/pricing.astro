---
import Layout from '../layouts/Layout.astro';
import { isDraftRoute } from '../draft.mjs';
const draft = isDraftRoute(Astro.url.pathname, import.meta.env.BASE_URL);
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
// CD-261117 pricing mockup — STAGING ONLY. DRAFT copy for Hemingway review; not approved for live.
// Prices: Gary-locked rate card CD-261102-1 (2026-11-07), master_chief/projects/cdd/CDD_rate_card_LOCKED_2026-11-07.md.
// CD-261118-1 (DRAFT, branch retainer-tiers): Website/Chatbot Maintenance $200–$400/mo replaced by retainer tiers from
// draper/clients/cookie-dough/strategic_growth_plan_2026-11-18_v2_APPROVED.md ("Retainer tier proposal"). Blurb = plan's "For" row,
// includes = plan's "What's covered each month" row. Group title + CTA are placeholders pending Hemingway.
type Line = { name: string; blurb: string; price: string; unit?: string; note?: string; includes?: string[]; cta: string; subject: string };
const groups: { kicker: string; title: string; lines: Line[] }[] = [
  { kicker: 'Websites', title: 'Websites', lines: [
    { name: 'Site Health Check', blurb: 'A plain-English checkup on whether your website is quietly losing you customers.', price: 'Free', cta: 'Get your free health check', subject: 'Site Health Check' },
    { name: 'Site Improvements', blurb: 'Targeted fixes on the site you already have.', price: '$500–$1,500', note: 'Depends on the punch list.', cta: 'Book a free call', subject: 'Site Improvements' },
    { name: 'Squarespace Website Build', blurb: 'A fresh Squarespace site in your brand, built to get bookings.', price: '$1,500–$5,000', cta: 'Book a free consultation', subject: 'Squarespace Website Build' },
    { name: 'Custom Website (GitHub + Astro)', blurb: 'A fast, lean, custom-built marketing site.', price: '$2,000–$4,000', cta: 'Book a free consultation', subject: 'Custom Website' },
  ]},
  { kicker: 'Chatbot Agents', title: 'Chatbot Agents', lines: [
    { name: 'Chatbot Creation', blurb: 'Custom AI agents that book appointments, capture leads and follow up.', price: '$1,500–$5,000', cta: 'Book a demo call', subject: 'Chatbot Creation' },
  ]},
  { kicker: 'Monthly Care', title: 'Monthly Care', lines: [
    { name: 'Site Watch', blurb: 'For owners who want a trusted pit crew watching the live site, with a little room for small edits.', price: '$250', unit: '/mo',
      includes: ['Uptime and SSL checks', 'Form and tracking spot check', 'Up to 1 small content or layout edit', 'Short monthly note'], cta: 'Book a free call', subject: 'Site Watch' },
    { name: 'Site Care', blurb: 'For owners who want regular edits and hygiene, not just monitoring.', price: '$400', unit: '/mo',
      includes: ['Everything in Site Watch', 'Up to 4 small page edits', 'Plugin/app and security hygiene checks where the platform allows', 'On-page cleanup (titles, headings, broken links) inside that edit budget', 'Staging-first changes with a short walkthrough when something goes live'], cta: 'Book a free call', subject: 'Site Care' },
    { name: 'Site + Bot Care', blurb: 'For owners who have (or are adding) a Cookie Dough chatbot and want the site and the bot kept current.', price: '$700', unit: '/mo',
      includes: ['Everything in Site Care', 'Chatbot FAQ and content updates when offers change', 'Connection checks for calendar, forms and inboxes', 'Light conversation tuning from real chats'], cta: 'Book a free call', subject: 'Site + Bot Care' },
  ]},
  { kicker: 'Brand, AI & Projects', title: 'Brand, AI & Projects', lines: [
    { name: 'Brand Reimagination', blurb: 'A full refresh of how your business looks and sounds.', price: '$500–$3,000', note: 'Includes 1 round of revisions. Extra rounds $200 each.', cta: 'Book a free call', subject: 'Brand Reimagination' },
    { name: 'Business AI Implementation Consultation', blurb: 'A hands-on working session that sets up your first useful AI wins.', price: '$1,000–$3,000', cta: 'Book a training or consult', subject: 'AI Implementation Consultation' },
    { name: 'Project Based Digital Implementation', blurb: 'One digital problem, scoped and fixed. No monthly contract.', price: 'Clear quote after a free call', cta: 'Get a project quote', subject: 'Digital Project Quote' },
  ]},
];
---
<Layout title="Pricing · Cookie Dough Digital" description="Pricing for websites, chatbot agents, brand work and AI help for Lowcountry small businesses. Every paid job starts with a free call and a clear quote.">
<section class="head on-marsh"><div class="container">
  {draft && <p class="draft"><span class="tag">DRAFT</span> Draft preview. Not live yet.</p>}
  <h1>Pricing</h1>
  <p class="lede">Every paid job starts with a free call. You get a clear quote before anything starts.</p>
</div></section>
{groups.map((g) => (
<section class="section group"><div class="container">
  <h2>{g.title}</h2>
  <div class="grid">{g.lines.map((l) => (
    <article class="card price-card">
      <h3>{l.name}</h3>
      <p class="blurb">{l.blurb}</p>
      <p class={l.price.startsWith('$') || l.price === 'Free' ? 'price' : 'price price-text'}>{l.price}{l.unit && <span class="unit">{l.unit}</span>}</p>
      {l.note && <p class="note">{l.note}</p>}
      {l.includes && <ul class="includes">{l.includes.map((i) => <li>{i}</li>)}</ul>}
      <a class="btn btn-ghost" href={`mailto:cookiedoughdigital@gmail.com?subject=${encodeURIComponent(l.subject)}`}>{l.cta}</a>
    </article>))}
  </div>
</div></section>))}
<section class="section"><div class="container">
  <p class="fine">Most prices are ranges. Your exact price comes in a clear quote after a free call.</p>
  <div class="band">
    <div><h2>Not sure where you fit?</h2><p>Start with a free call. No pressure, no long contracts unless you want one.</p></div>
    <a class="btn btn-primary" href="mailto:cookiedoughdigital@gmail.com?subject=Consultation">Book a free call</a>
  </div>
  <p class="back"><a href={`${b}/services/`}>← Back to Services</a></p>
</div></section>
<Fragment slot="footer"><p><a href="tel:4046604023">404-660-4023</a></p><p><a href="mailto:cookiedoughdigital@gmail.com">cookiedoughdigital@gmail.com</a></p><p>Bluffton · Hilton Head · Beaufort, SC</p></Fragment>
</Layout>
<style>
.head{background:var(--marsh);color:var(--oyster);padding:40px 0 56px}
.head h1{font-size:76px}
.lede{font-size:18px;max-width:720px;margin:12px 0 0;line-height:1.4}
.draft{margin:0 0 20px;font-size:14px;opacity:.95;display:flex;align-items:center;gap:10px}
.group{padding-top:56px;padding-bottom:0}
.group h2{font-size:36px;margin-bottom:24px}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.price-card{display:flex;flex-direction:column;gap:10px;padding:24px}
.price-card h3{font-size:22px}
.blurb{margin:0;color:var(--sage);font-size:16px;line-height:1.45}
.price{margin:6px 0 0;font-family:var(--serif);font-weight:800;font-size:32px;color:var(--marsh);line-height:1.1}
.unit{font-family:var(--sans);font-weight:700;font-size:16px;color:var(--sage);margin-left:2px}
.price.price-text{font-family:var(--sans);font-weight:700;font-size:17px;line-height:1.35}
.note{margin:0;font-size:14px;color:var(--sage)}
.includes{margin:0 0 4px;padding-left:18px;font-size:14px;line-height:1.45;color:var(--sage)}.includes li+li{margin-top:4px}
.price-card .btn{margin-top:auto;align-self:flex-start}
.price-card .price + .btn,.price-card .note + .btn{margin-top:auto}
.fine{color:var(--sage);font-size:15px;margin:0 0 24px}
.band{background:var(--marsh);color:var(--oyster);border-radius:var(--r);padding:48px;display:flex;justify-content:space-between;align-items:center;gap:32px}
.band h2{font-size:36px}.band p{margin:10px 0 0;font-size:18px;opacity:.9}.band .btn{font-size:18px;padding:16px 26px;white-space:nowrap}
.back{margin-top:24px}
@media(max-width:1000px){.grid{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.head{padding:24px 0 36px}.head h1{font-size:44px}.lede{font-size:16px}
.group{padding-top:40px}.group h2{font-size:26px;margin-bottom:16px}.grid{grid-template-columns:1fr;gap:14px}.price{font-size:28px}.price.price-text{font-size:16px}
.band{flex-direction:column;align-items:flex-start;padding:28px 22px}.band h2{font-size:26px}}
</style>
